# Arc network endpoints (copy to .env.local and fill in).
# Chain IDs: testnet 5042002, mainnet 5042. USDC (18 decimals) is the gas token.
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_TESTNET_CHAIN_ID=5042002
NEXT_PUBLIC_TESTNET_PRIMARY_CONTRACT_ID=REPLACE_WITH_VERIFIED_TESTNET_CONTRACT_ID

NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_MAINNET_CHAIN_ID=5042
NEXT_PUBLIC_MAINNET_PRIMARY_CONTRACT_ID=REPLACE_WITH_VERIFIED_MAINNET_CONTRACT_ID
