  "landing.feat1Desc": "ᓯᓚᑐᔪᑦ ᑳᓐᑐᕌᑦ ᐊᑐᓕᖅᑎᑦᑎᕙᒻᒪᑕ ᒪᓕᒐᓕᒫᓂᒃ. ᐋᖅᑭᒃᓱᐃᔨᐅᔪᖅ ᐳᐃᔾᔪᕋᕐᕕᒻᒧᑦ ᕿᒫᔪᓐᓇᖏᑦᑐᖅ. ᑐᓂᕐᕈᓯᐊᓕᒫᑦ ᓇᓗᓇᐃᖅᑕᐅᓯᒪᔪᑦ ᑕᕝᕙᓂ.",
  "landing.feat1Title": "ᐅᑉᐱᕆᔭᐅᔪᓐᓇᖏᑦᑐᖅ ᓴᖅᑭᔮᑦᑎᐊᕐᓗᓂᓗ",
  "landing.feat2Desc": "ᑭᓇᑐᐃᓐᓇᖅ ᑮᓇᐅᔭᒃᑯᕕᖃᖅᑐᖅ. ᑮᓇᐅᔭᒃᑯᕕᒻᒥ ᑮᓇᐅᔭᖃᙱᓚᖅ. ᐊᑭᓕᒃᓴᖃᕐᓂᖏᓐᓄᑦ ᖃᐅᔨᓴᖅᑕᐅᔭᕆᐊᖃᙱᑦᑐᑦ. ᑭᓪᓕᖃᓐᖏᑦᑐᖅ.",
  "landing.feat2Title": "ᓄᓇᕐᔪᐊᕐᒥ ᐊᑐᐃᓐᓇᖃᕐᓂᖅ",
  "landing.feat3Desc": "ᓴᓇᓗᑎᑦ MoiScore-ᒥᒃ ᑭᖑᕙᙱᓪᓗᑎᑦ ᑐᓂᓯᖃᑦᑕᕐᓗᑎᑦ. ᓇᒃᓴᕋᒃᓴᖅ ᑮᓇᐅᔭᓕᕆᓂᕐᒧᑦ ᓇᓗᓇᐃᒃᑯᑕᖅ.",
  "landing.feat3Title": "ᖃᕆᑕᐅᔭᒃᑯᑦ ᑐᓴᐅᒪᔭᐅᑦᑎᐊᕐᓂᖅ",
  "landing.feat4Desc": "ᓴᓐᓯᐅᑉ ᑐᖔᓂ ᑮᓇᐅᔭᓕᕆᓂᖅ ᖃᐅᑕᒫᑦ ᑲᐃᓪᓗᐊᕈᑎᓂᒃ ᐊᑐᕈᓐᓇᖅᓯᑎᑦᑎᕗᖅ. ᐊᑭᖃᙱᑦᑐᖅ ᓴᖅᑭᑦᑎᓂᕐᒧᑦ ᐃᓚᐅᓂᕐᒧᓪᓘᓐᓃᑦ.",
  "landing.feat4Title": "ᖃᓂᒋᔮᓂ-ᐱᑕᖃᙱᑦᑐᖅ ᐊᑭᓕᕆᐊᓖᑦ",
  "landing.feat5Desc": "ᓇᓕᐊᑐᐃᓐᓇᖅ, ᐋᖅᑭᒃᓯᒪᔪᖅ, ᐊᑭᑦᑐᕋᐅᑎᓂᖅ, ᐅᕝᕙᓘᓐᓃᑦ ᓂᕈᐊᕐᓂᖅ. ᑲᑎᙵᓂᕆᔭᐃᑦ, ᒪᓕᒐᑎᑦ.",
  "landing.feat5Title": "ᐊᓯᔾᔨᖅᑕᕈᓐᓇᖅᑐᑦ ᒪᓕᒐᐃᑦ",
  "landing.feat6Desc": "USDC ᐅᓪᓗᒥ. ᐊᒥᓲᓂᖅᓴᐃᑦ ᑮᓇᐅᔭᐃᑦ ᐊᖅᑯᑎᐅᑉ ᓄᓇᙳᐊᖓᓂ.",
  "landing.feat6Title": "ᐊᔾᔨᒌᙱᑦᑐᓄᑦ ᑮᓇᐅᔭᓄᑦ",
